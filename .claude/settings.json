{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_tema_26": "Settings versionados del repo. Mezcla deliberada de reglas tecnicas (allow/deny, hooks) y entradas que en realidad son convenciones humanas (language, responseStyle) - el Ejercicio 2 del Tema 26 consiste en redistribuirlas entre managed, project y CLAUDE.md.",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Bash(node --version)",
      "Bash(bash scripts/dev-server.sh)",
      "Bash(scripts/dev-server.sh)",
      "mcp__filesystem__read_file",
      "mcp__filesystem__read_multiple_files",
      "mcp__filesystem__list_directory",
      "mcp__filesystem__directory_tree",
      "mcp__filesystem__search_files",
      "mcp__filesystem__get_file_info",
      "mcp__filesystem__list_allowed_directories",
      "mcp__notebox__notebox_list_notes",
      "mcp__notebox__notebox_get_note"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm -rf *)",
      "mcp__notebox__notebox_delete_note"
    ]
  },
  "defaultMode": "acceptEdits",
  "language": "es",
  "responseStyle": "concise",
  "enabledPlugins": [
    "pr-helper"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/plugins/pr-helper/hooks/pre-bash-audit.sh"
          }
        ]
      }
    ]
  }
}
