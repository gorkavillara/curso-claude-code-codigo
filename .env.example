# Plantilla de variables de entorno para Notebox (Tema 23).
# Cópiala a .env (no commiteado) y rellena valores reales si los necesitas.
#
# IMPORTANTE: la variable del puerto se llama SERVER_PORT, no PORT.
# La app lee process.env.SERVER_PORT en src/server.ts.

# Server
SERVER_PORT=3001
NODE_ENV=development

# Database (servicio db-dummy del docker-compose, no activo por defecto)
POSTGRES_USER=notebox
POSTGRES_PASSWORD=notebox_dev_password
POSTGRES_DB=notebox_dev
DATABASE_URL=postgres://notebox:notebox_dev_password@db-dummy:5432/notebox_dev
